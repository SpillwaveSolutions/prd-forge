{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.prd-forge.dev/prd-root.json",
  "title": "PRD root document",
  "description": "The index of a PRD document set: the executive summary, the product's identity, and a link to every section.",
  "allOf": [
    {
      "$ref": "common.json#/$defs/base"
    }
  ],
  "type": "object",
  "properties": {
    "product": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "$ref": "common.json#/$defs/slug"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+(\\.\\d+)?$"
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "description": "The one person accountable for this PRD."
    },
    "stakeholders": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "minLength": 1
              },
              "interest": {
                "type": "string",
                "minLength": 1
              },
              "influence": {
                "type": "string",
                "enum": [
                  "high",
                  "medium",
                  "low"
                ],
                "description": "How much they can change the outcome."
              }
            },
            "required": [
              "role"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 1
    },
    "created": {
      "$ref": "common.json#/$defs/date"
    },
    "summary": {
      "type": "object",
      "description": "The executive summary, in five answers. This is the only place the PRD repeats itself, and it is worth it.",
      "properties": {
        "problem": {
          "type": "string",
          "minLength": 1,
          "description": "What problem exists, for whom."
        },
        "users": {
          "type": "string",
          "minLength": 1,
          "description": "Who uses it."
        },
        "why_now": {
          "type": "string",
          "minLength": 1,
          "description": "Why this is worth doing now."
        },
        "bet": {
          "type": "string",
          "minLength": 1,
          "description": "What we will build, in outcome terms, with no technology named."
        },
        "measure": {
          "type": "string",
          "minLength": 1,
          "description": "How we will know it worked."
        },
        "objective": {
          "type": "string",
          "pattern": "^O-\\d{3}$",
          "description": "The objective in section 3 that the measure tracks."
        }
      },
      "required": [
        "problem",
        "users",
        "why_now",
        "bet",
        "measure"
      ],
      "additionalProperties": false
    },
    "golden_thread": {
      "type": "string",
      "description": "The id of the one journey release 1 must deliver end to end."
    },
    "primary_persona": {
      "type": "string",
      "pattern": "^PER-\\d{3}$",
      "description": "The persona the product serves first."
    },
    "approvers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^PER-\\d{3}$"
      },
      "description": "The roles whose approval section 15 must record before the set is final."
    }
  },
  "required": [
    "product",
    "slug",
    "version",
    "owner",
    "stakeholders",
    "created",
    "summary"
  ]
}
