{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.prd-forge.dev/objectives-metrics.json",
  "title": "Business objectives and success metrics (section 3)",
  "description": "What business result we expect, with a baseline and a target for each.",
  "allOf": [
    {
      "$ref": "common.json#/$defs/base"
    },
    {
      "$ref": "common.json#/$defs/section"
    }
  ],
  "type": "object",
  "properties": {
    "objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^O-\\d{3}$",
            "description": "Stable identifier; never reused or renumbered."
          },
          "objective": {
            "type": "string",
            "minLength": 1,
            "description": "The business result, not the feature."
          },
          "problems": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^P-\\d{3}$"
            },
            "description": "The problems in section 1 this objective addresses."
          },
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "baseline": {
            "type": "string",
            "minLength": 1,
            "description": "What it measures today. 'unknown' is an open question, not a baseline."
          },
          "baseline_question": {
            "type": "string",
            "pattern": "^Q-\\d{3}$",
            "description": "The open question in section 12 that will establish an unknown baseline."
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "by": {
            "$ref": "common.json#/$defs/date"
          },
          "owner": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "objective",
          "metric",
          "baseline",
          "target",
          "owner"
        ]
      },
      "minItems": 1
    },
    "guardrails": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "metric": {
            "type": "string",
            "minLength": 1,
            "description": "What must not get worse while the objectives move."
          },
          "threshold": {
            "type": "string",
            "minLength": 1,
            "description": "The level it must stay at, with a number."
          },
          "owner": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "metric",
          "threshold"
        ],
        "additionalProperties": false
      },
      "description": "Guardrail (counter) metrics: what must not get worse."
    }
  },
  "required": [
    "objectives"
  ]
}
