{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.prd-forge.dev/problem-opportunity.json",
  "title": "Problem and opportunity (section 1)",
  "description": "What problem exists, for whom, and why now.",
  "allOf": [
    {
      "$ref": "common.json#/$defs/base"
    },
    {
      "$ref": "common.json#/$defs/section"
    }
  ],
  "type": "object",
  "properties": {
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^P-\\d{3}$",
            "description": "Stable identifier; never reused or renumbered."
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "description": "The problem in the user's words, with no solution in it."
          },
          "who": {
            "type": "string",
            "minLength": 1
          },
          "persona": {
            "type": "string",
            "pattern": "^PER-\\d{3}$",
            "description": "The persona in section 4 who has this problem."
          },
          "evidence": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "object",
                  "properties": {
                    "claim": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Where it comes from."
                    },
                    "as_of": {
                      "$ref": "common.json#/$defs/date"
                    }
                  },
                  "required": [
                    "claim",
                    "source"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "minItems": 1,
            "description": "What makes this more than an opinion."
          },
          "why_now": {
            "type": "string",
            "minLength": 1
          },
          "cost_of_inaction": {
            "type": "string",
            "minLength": 1
          },
          "status_quo": {
            "type": "string",
            "minLength": 1,
            "description": "What they do today instead, and why it fails."
          },
          "desired_outcome": {
            "type": "string",
            "minLength": 1,
            "description": "The outcome they want, with no solution in it."
          }
        },
        "required": [
          "id",
          "statement",
          "who",
          "evidence",
          "why_now"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "problems"
  ]
}
