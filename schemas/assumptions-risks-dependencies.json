{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.prd-forge.dev/assumptions-risks-dependencies.json",
  "title": "Assumptions, risks and dependencies (section 11)",
  "description": "What we assume, what can go wrong, and what we need from others.",
  "allOf": [
    {
      "$ref": "common.json#/$defs/base"
    },
    {
      "$ref": "common.json#/$defs/section"
    }
  ],
  "type": "object",
  "properties": {
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^A-\\d{3}$",
            "description": "Stable identifier; never reused or renumbered."
          },
          "assumption": {
            "type": "string",
            "minLength": 1
          },
          "if_false": {
            "type": "string",
            "minLength": 1,
            "description": "What breaks if this is wrong."
          },
          "validated_by": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "value",
              "usability",
              "feasibility",
              "viability"
            ],
            "description": "Which of the four product risks it is."
          },
          "evidence": {
            "type": "string",
            "enum": [
              "none",
              "some",
              "strong"
            ],
            "description": "How much evidence supports it today."
          },
          "validate_by": {
            "$ref": "common.json#/$defs/date"
          }
        },
        "required": [
          "id",
          "assumption",
          "if_false"
        ]
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^R-\\d{3}$",
            "description": "Stable identifier; never reused or renumbered."
          },
          "risk": {
            "type": "string",
            "minLength": 1
          },
          "likelihood": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "impact": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "mitigation": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "trigger": {
            "type": "string",
            "minLength": 1,
            "description": "What shows the risk is happening."
          },
          "response": {
            "type": "string",
            "enum": [
              "avoid",
              "reduce",
              "transfer",
              "share",
              "accept"
            ],
            "description": "How the risk is handled."
          },
          "mitigation_by": {
            "$ref": "common.json#/$defs/date"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "occurred",
              "closed"
            ],
            "description": "Where the risk stands."
          }
        },
        "required": [
          "id",
          "risk",
          "likelihood",
          "impact",
          "mitigation",
          "owner"
        ]
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^D-\\d{3}$",
            "description": "Stable identifier; never reused or renumbered."
          },
          "need": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string",
            "minLength": 1,
            "description": "The team, vendor or person we need it from."
          },
          "by": {
            "$ref": "common.json#/$defs/date"
          },
          "status": {
            "type": "string",
            "enum": [
              "requested",
              "committed",
              "at-risk",
              "delivered"
            ]
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "need",
          "from",
          "status",
          "by"
        ]
      }
    }
  },
  "required": [
    "assumptions",
    "risks",
    "dependencies"
  ]
}
