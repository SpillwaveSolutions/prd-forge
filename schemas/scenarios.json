{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.prd-forge.dev/scenarios.json",
  "title": "Scenarios (section 5)",
  "description": "Concrete runs through a journey: the happy path, the alternates, and the exceptions.",
  "allOf": [
    {
      "$ref": "common.json#/$defs/base"
    },
    {
      "$ref": "common.json#/$defs/section"
    }
  ],
  "type": "object",
  "properties": {
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SC-\\d{3}$",
            "description": "Stable identifier; never reused or renumbered."
          },
          "journey": {
            "type": "string",
            "pattern": "^J-\\d{3}$"
          },
          "stage": {
            "type": "string",
            "pattern": "^ST-\\d{3}$"
          },
          "persona": {
            "type": "string",
            "minLength": 1
          },
          "variant": {
            "type": "string",
            "enum": [
              "happy",
              "alternate",
              "exception"
            ]
          },
          "priority": {
            "$ref": "common.json#/$defs/priority",
            "description": "Whether release 1 must handle this scenario. A must scenario sits on a release-line stage."
          },
          "context": {
            "type": "string",
            "minLength": 1,
            "description": "The state of the world when this starts."
          },
          "trigger": {
            "type": "string",
            "minLength": 1
          },
          "course": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "description": "What happens, in order."
          },
          "expected_outcome": {
            "type": "string",
            "minLength": 1,
            "description": "What the user sees at the end. A pass or fail statement."
          },
          "wireframes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^WF-\\d{3}$"
            },
            "description": "The wireframes that show what the user sees in this scenario, by id."
          },
          "lifecycles": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^LC-\\d{3}$"
            },
            "description": "The lifecycles this scenario moves through, by id."
          }
        },
        "required": [
          "id",
          "journey",
          "persona",
          "variant",
          "context",
          "trigger",
          "course",
          "expected_outcome"
        ]
      },
      "minItems": 1
    },
    "lifecycles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^LC-\\d{3}$"
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "description": "The thing the user works on, in the domain's words."
          },
          "states": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "meaning": {
                  "type": "string",
                  "minLength": 1,
                  "description": "What the user can tell from this state."
                }
              },
              "required": [
                "name",
                "meaning"
              ],
              "additionalProperties": false
            }
          },
          "initial": {
            "type": "string",
            "minLength": 1
          },
          "final": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "transitions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string",
                  "minLength": 1
                },
                "to": {
                  "type": "string",
                  "minLength": 1
                },
                "when": {
                  "type": "string",
                  "minLength": 1,
                  "description": "What happens, as the user sees it, to move the subject on."
                },
                "rule": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The business rule that must hold for the move."
                },
                "by": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Who makes the move, by persona id or role."
                }
              },
              "required": [
                "from",
                "to",
                "when"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "subject",
          "states",
          "initial",
          "transitions"
        ],
        "additionalProperties": false
      },
      "description": "The lifecycles of what users work on: the states, and the business rules that move it from one to the next. Drawn as state diagrams."
    }
  },
  "required": [
    "scenarios"
  ]
}
