{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.prd-forge.dev/change-log.json",
  "title": "Change log and approvals (section 15)",
  "description": "What changed, when, and who approved it.",
  "allOf": [
    {
      "$ref": "common.json#/$defs/base"
    },
    {
      "$ref": "common.json#/$defs/section"
    }
  ],
  "type": "object",
  "properties": {
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+(\\.\\d+)?$"
          },
          "date": {
            "$ref": "common.json#/$defs/date"
          },
          "author": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 15
            }
          },
          "approvals": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "type": "string",
                  "minLength": 1
                },
                "date": {
                  "$ref": "common.json#/$defs/date"
                },
                "decision": {
                  "type": "string",
                  "enum": [
                    "approved",
                    "approved-with-conditions",
                    "rejected"
                  ]
                },
                "conditions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "condition": {
                        "type": "string",
                        "minLength": 1
                      },
                      "depends_on": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[A-Z]{1,4}-\\d{3}$"
                        },
                        "description": "The open questions, requirements, or review comments the condition depends on.",
                        "minItems": 1
                      },
                      "by": {
                        "$ref": "common.json#/$defs/date"
                      },
                      "cleared": {
                        "type": "boolean"
                      },
                      "cleared_by": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Who cleared the condition. Only the approver who set it clears it."
                      }
                    },
                    "required": [
                      "condition",
                      "depends_on",
                      "by"
                    ],
                    "additionalProperties": false
                  },
                  "description": "The conditions of an approval with conditions: each names what it depends on and a date."
                },
                "note": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Why the approver decided as they did. Required for a rejection."
                }
              },
              "required": [
                "name",
                "role",
                "date",
                "decision"
              ]
            }
          },
          "resolves": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^Q-\\d{3}$"
            },
            "description": "The open questions this change answers."
          },
          "overrides": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "section": {
                  "type": "integer",
                  "minimum": 1
                },
                "status": {
                  "type": "string",
                  "minLength": 1
                },
                "score": {
                  "type": "integer"
                },
                "blocking": {
                  "type": "integer"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "section",
                "status"
              ],
              "additionalProperties": false
            },
            "description": "Gates the expert overrode, with the score at the time."
          }
        },
        "required": [
          "version",
          "date",
          "author",
          "summary"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "changes"
  ]
}
